# ============================================================
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# ---- DEMO MODE (no credentials required) -------------------
# Set RUN_MODE=demo to skip all email/API configuration.
# Just drop Contractor_Update.xlsx in data/ and run.

RUN_MODE=demo

# ---- GMAIL MODE (optional — for full integration) ----------
# Required only when RUN_MODE=gmail

# Gmail inbox to monitor for contractor emails
GMAIL_MONITOR_ADDRESS=your-address@gmail.com

# Subject line to filter contractor emails
GMAIL_SUBJECT_FILTER=Biweekly Renovation Update

# Expected attachment filename from contractor
GMAIL_ATTACHMENT_FILENAME=Contractor_Update.xlsx

# Path to your Gmail OAuth2 credentials JSON file
# Download from: https://console.cloud.google.com/
GMAIL_CREDENTIALS_FILE=config/gmail_credentials.json

# Path where Gmail OAuth2 token will be cached after first login
GMAIL_TOKEN_FILE=config/gmail_token.json

# ---- COORDINATOR EMAIL (optional) --------------------------
# Used only if you want to send the summary email via Gmail SMTP
# Leave blank to skip email sending (HTML report will open in browser instead)
COORDINATOR_EMAIL=coordinator@yourcompany.com

# ---- FILE PATHS (defaults are usually fine) ----------------
MASTER_TRACKER_PATH=data/Master_Tracker.xlsx
CONTRACTOR_UPDATE_PATH=data/Contractor_Update.xlsx
OUTPUT_DIR=output
